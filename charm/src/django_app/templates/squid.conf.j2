# Generated by terrasquid
# Config version: {{ version }}
# DO NOT EDIT — managed by the Terrasquid charm

http_port [::]:{{ squid_port }}
coredump_dir /var/spool/squid
access_log daemon:/var/log/squid/access.log squid
cache_log /var/log/squid/cache.log
logfile_rotate 0

# Cache-manager statistics are available only to the local exporter.
acl manager proto cache_object
acl localhost src 127.0.0.1/32 ::1
http_access allow localhost manager
http_access deny manager

{% if squid_prepend_config %}
{{ squid_prepend_config }}
{% endif %}
# ======= Source ACLs =======
{% for src in source_acls %}
{% if src.comment %}
# {{ src.comment }}
{% endif %}
acl src__{{ src.key_prefix }}__{{ src.name }} src {{ src.cidr | join(' ') }}
{% endfor %}

# ======= Destination ACLs =======
{% for dst in destination_configs %}
{% if dst.comment %}
# {{ dst.comment }}
{% endif %}
{% if dst.is_cidr %}
acl dst__{{ dst.key_prefix }}__{{ dst.name }} dst {{ dst.dst }}
{% else %}
acl dst__{{ dst.key_prefix }}__{{ dst.name }} dstdomain {{ dst.dst }}
{% endif %}

{% endfor %}

# ======= Destination Group ACLs =======
{% for entry in destination_group_entries %}
# Service: {{ entry.group.service }}; group: {{ entry.group.name }}
{% if entry.group.comment %}
# {{ entry.group.comment }}
{% endif %}
{% for bucket in entry.buckets %}
{% for line in bucket.destination_acl_names | any_of_lines(bucket.acl_name) %}
{{ line }}
{% endfor %}
{% endfor %}
{% endfor %}

# ======= Port ACLs =======
{% for ports in port_sets %}
acl port__{{ ports | join('_') }} port {{ ports | join(' ') }}
{% endfor %}

# ======= Method ACLs =======
acl CONNECT method CONNECT

# ======= ACL Rules (ordered by priority) =======
{% for entry in rule_entries %}
{% if entry.source_acl_names | length > 1 %}
{% for line in entry.source_acl_names | any_of_lines(entry.source_acl_name) %}
{{ line }}
{% endfor %}
{% endif %}
{% for bucket in entry.buckets %}
{% if bucket.destination_acl_names | length > 1 %}
{% for line in bucket.destination_acl_names | any_of_lines(bucket.destination_acl_name) %}
{{ line }}
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}
{% for entry in acl_access_entries %}
{% set rule = entry.rule %}
{% set bucket = entry.bucket %}
{% set action = 'allow' if bucket.type in ('ALLOW', 'CONNECT') else 'deny' %}
{% if rule.comment %}
# {{ rule.comment }}
{% else %}
# Service: {{ rule.service }}; rule: {{ rule.name }}
{% endif %}
http_access {{ action }} {{ entry.source_acl_name }}{% if bucket.type == 'CONNECT' %} CONNECT{% endif %} {{ bucket.destination_acl_name }} port__{{ bucket.ports | join('_') }}
{% endfor %}

{% if squid_append_config %}
{{ squid_append_config }}
{% endif %}
# Default deny
{% if squid_default_deny %}
http_access deny all
{% endif %}
